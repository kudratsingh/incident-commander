# Anthropic (required)
# Empty or placeholder values ("", "eval", "placeholder") are the offline-canned
# trigger: scenarios that declare use_live_llm silently fall back to canned
# responses. Any --live invocation now refuses such a value with exit 3
# (ADR 0013) — fill in a real key before `make eval-live` / `make eval-smoke`.
ANTHROPIC_API_KEY=

# Models (verify current strings against https://docs.claude.com before changing)
# AGENT_MODEL is optional; unset or blank uses the default in
# src/incident_commander/config.py.
AGENT_MODEL=claude-sonnet-4-6
# JUDGE_MODEL is required and pinned independently of AGENT_MODEL —
# changes require an ADR note (CLAUDE.md).
JUDGE_MODEL=

# Path to the incident-platform docker-compose.yml, used by `make eval-reset`
# to shell into the platform's `app` container. Defaults to the sibling
# checkout (../incident-platform/docker-compose.yml); set it here if your
# platform repo lives elsewhere, otherwise eval-reset exits 2. Read by make
# (not Python) — leave it unquoted, and use an absolute path.
# PLATFORM_COMPOSE=/absolute/path/to/incident-platform/docker-compose.yml

# Platform connection. MCP and REST are separate URLs; the platform runs MCP
# as its own process (platform ADR-0006). For local development against
# `make demo`, MCP is at http://localhost:8001/mcp. If 8001 is already in
# use on your host (e.g. you have a native platform running), override
# DEMO_MCP_HOST_PORT below and update PLATFORM_MCP_URL to match.
PLATFORM_MCP_URL=http://localhost:8001/mcp
PLATFORM_REST_URL=http://localhost:8000
# Host port `make demo` publishes for the platform MCP service. Only read
# by demo/compose.yml — the agent itself uses PLATFORM_MCP_URL.
DEMO_MCP_HOST_PORT=8001
# Service-account bearer token for MCP (platform naming convention: sa_*).
# Provisioned on the platform side under scope telemetry:read + incidents:read
# for the `incident-commander` seed principal. Required.
PLATFORM_TOKEN=
# Read-only twin (telemetry:read + incidents:read only) used by
# `make eval-smoke`. Minted alongside PLATFORM_TOKEN by
# `make bootstrap-token`. With it, the smoke pass cannot execute Tier-1
# actions even if the agent tries — the platform 403s. Leave blank until
# minted; `make eval-smoke` fails fast without it. Blank means UNSET, not
# "use the default": the runner exits 3 rather than letting the smoke stage
# fall back to the write-scoped PLATFORM_TOKEN above (S-04).
PLATFORM_SMOKE_TOKEN=
# Principal ids of the two service accounts above — also printed by
# `make bootstrap-token`. Ids, not credentials: they carry no scope and
# authenticate nothing. When BOTH are set, the post-stage audit guard only
# fails the smoke stage on Tier-1 successes by these principals, so a
# shared platform's other service accounts cannot false-fail it. Both are
# required, not just the smoke one: the wrong-token failure mode this
# guard exists for writes its audit rows under the AGENT principal. Leave
# unset and any service_account's in-window Tier-1 success fails the stage
# (over-broad on purpose — see docs/runbook.md).
# PLATFORM_AGENT_PRINCIPAL_ID=
# PLATFORM_SMOKE_PRINCIPAL_ID=
PLATFORM_WEBHOOK_SECRET=
# Webhook ingress skew window, in seconds (ADR 0014). Deliveries whose
# X-Alert-Timestamp (epoch ms, sent by the platform emitter) deviates from
# local time by more than this are rejected with 401, and an identical
# redelivery inside the window is answered 202 without spawning a second run.
WEBHOOK_MAX_SKEW_SECONDS=300

# Agent-owned Postgres (required)
DATABASE_URL=

# Per-incident hard budgets (CLAUDE.md invariant 7). Optional — leave unset
# (or blank) to use the defaults in src/incident_commander/config.py.
# All four ceilings are enforced: exhausting any one escalates the run with
# "budget exhausted" (docs/safety-model.md#budgets, ADR 0015).
# Uncomment to override:
# Charged +1 per probe, action, and verify poll.
# BUDGET_MAX_TOOL_CALLS=25
# Total token volume: input + output + cache-creation + cache-read.
# BUDGET_MAX_TOKENS=500000
# Wall clock, measured from the run's created_at (survives crash-resume).
# BUDGET_MAX_SECONDS=1800
# Dollars, from the pinned price map in src/incident_commander/llm/pricing.py.
# BUDGET_MAX_USD=5.00

# Kill switch (docs/safety-model.md#kill-switch): false stops the state
# machine from advancing while the webhook keeps recording alerts. Requires
# a process restart to change (Settings is frozen and cached).
AGENT_ENABLED=true

# Live-run probe knobs (ADR 0006 verify polling, ADR 0009 freshness
# re-probe; table of record: docs/runbook.md "Environment variable knobs").
# Shipped here at the live-recommended values. Canned/offline runs are
# unaffected by construction — the eval runner forces single-probe and
# no-reprobe whenever the platform is a placeholder — while live runs NEED
# these to avoid the two documented live failure modes: a single instant
# verify read judged against the 60s-cached consumer lag (PR #49), and a
# stale cached read killing a correct hypothesis with no re-probe (PR #65).
VERIFY_PROBE_ATTEMPTS=6
VERIFY_PROBE_DELAY_SECONDS=20
INVESTIGATE_REPROBE_ATTEMPTS=1
INVESTIGATE_REPROBE_DELAY_SECONDS=20
# Timeout for Tier-1 action tool calls in live runs (reads keep the MCP
# client's 30s default). Optional — default 60.
# ACTION_TOOL_TIMEOUT_SECONDS=60

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
.python-version

# Virtual environments
.venv/
venv/
env/

# uv
.uv/
uv.lock

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments and secrets
.env
.env.*
!.env.example

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Eval and trajectory artifacts
evals/trajectories/*
!evals/trajectories/.gitkeep
evals/briefings/*
!evals/briefings/.gitkeep
evals/traces/*
!evals/traces/.gitkeep
evals/reports/latest.json
evals/reports/human/*
!evals/reports/human/.gitkeep

# Claude Code runtime artifacts (per-machine)
.claude/

# Per-invocation immutable run archive (CLAUDE.md invariant 9).
# Local evidence; large and machine-specific, so not committed — back it
# up outside the tree before any work that touches its writers (F-003).
evals/runs/*
!evals/runs/.gitkeep

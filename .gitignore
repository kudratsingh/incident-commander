*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
.python-version

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
